# Copy to .env for local development. On Railway, set these as service variables instead.

# Get a key at https://console.anthropic.com. Server only: never put it in the app.
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5-5

# Supabase project URL and publishable key (Project Settings > API Keys).
# The publishable key is safe to ship in the app. Never use the secret / service_role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Comma-separated emails allowed to use the tutor.
ALLOWED_EMAILS=you@example.com

# Railway sets PORT itself.
PORT=8787

# Optional: serve a local Flutter web build too (after `flutter build web`).
# WEB_DIR=../build/web

# Optional: Kinyarwanda read aloud from the TTS service in ../tts. Set both or neither;
# without them the app uses the device's voice. The secret must match the TTS service's.
# TTS_URL=http://localhost:8000
# TTS_SHARED_SECRET=a-long-random-string
# Memory for cached audio, in MB (default 50).
# TTS_CACHE_MB=50
